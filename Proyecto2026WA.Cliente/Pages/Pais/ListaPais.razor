@page "/paises"
@using System.Text.Json
@using Proyecto2026WA.Cliente.Pages.Shared
@using Proyecto2026WA.Shared.DTO
@using Proyecto2026WA.Servicio.ServicioHTTP
@inject IHttpService http
@* @inject HttpClient http*@
<h3>Lista de Paises</h3>

<br />
<a class="btn btn-primary" href="/paises/crear">Crear Pais</a>
<br>
<table>
    <tr>
        <th>Paises</th>
    </tr>
    @if (paises == null)
    {
        <p>Buscando ....</p>
    }
    else if (paises.Count == 0)
    {
        <p>No existen paises cargados en esta lista</p>
    }
    else
    {
        @foreach (var pais in paises)
        {
            <tr>
                <td>@pais.DatosPais (@pais.Id)</td>
                <td>
                    <a class="btn btn-primary" href="/paises/editar/@pais.Id">Actualizar</a>
                </td>
                <td>
                    <button class="btn btn-danger" @onclick="() => Borrar(pais.Id)">Eliminar</button>
                </td>
            </tr>
        }
    }
</table>
<br />
<p>@mensaje</p>
<br />

<Confirmacion @ref="confirmacion" 
              Titulo="Confirmar Eliminación"
              onCancel="Cancelar"
              onConfirm="EliminarPais"
              textCancelar="No"
              textOk="Sí">
    <p>Está por eliminar un pais</p>
    <br />
    <p>¿Está seguro?</p>
</Confirmacion>

@code {
    List<PaisListadoDTO>? paises;
    private string mensaje = "";

    Confirmacion confirmacion;
    private int idSeleccionado = 0;

    protected override async Task OnInitializedAsync()
    {
        await LeerPaises();
    }

    private async Task LeerPaises()
    {
        try
        {
            var resp = await http.GetAsync<List<PaisListadoDTO>>("api/pais/listapais");

            if (resp.Error)
            {
                mensaje = resp.Mensaje;
            }
            else
            {
                paises = resp.Respuesta;
            }

            // var response = await http.GetAsync("api/pais/listapais");

            // if (!response.IsSuccessStatusCode)
            // {
            //     mensaje = $"Error en la llamada HTTP. Código de estado: {response.StatusCode}";
            // }

            // var content = await response.Content.ReadAsStringAsync();
            // paises = JsonSerializer.Deserialize<List<PaisListadoDTO>>(content,
            //     new JsonSerializerOptions
            //     {
            //         PropertyNameCaseInsensitive = true
            //     });
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }

        // // paises = await http.GetFromJsonAsync<List<PaisListadoDTO>>("api/Pais/listapais");
        // var resp = await http.Get<List<PaisListadoDTO>>("api/pais/listapais");
        // if (!resp.Error)
        // {
        //     paises = resp.Respuesta;
        // }
        // else
        // {
        //     Mensaje = resp.ObtenerError();
        // }
    }

    private async Task Borrar(int id)
    {
        idSeleccionado = id;
        confirmacion.Ver();
    }

    private async Task EliminarPais()
    {
        try
        {
            var resp = await http.DeleteAsync<bool>($"api/pais/{idSeleccionado}");
            if (resp.Error)
            {
                mensaje = resp.Mensaje!;
            }
            else
            {
                confirmacion.Ocultar();
                mensaje = "El pais ha sido eliminado correctamente";
                idSeleccionado = 0;
                await LeerPaises();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }

    private void Cancelar()
    {
        confirmacion.Ocultar();
        idSeleccionado = 0;
    }
}
